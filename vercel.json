{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__route=$1" },
    { "source": "/company/(.*)", "destination": "/api/index?__route=company/$1" },
    { "source": "/workspaces/(.*)", "destination": "/api/index?__route=workspaces/$1" },
    { "source": "/billing", "destination": "/app.html?tab=billingCredits" },
    { "source": "/bookings", "destination": "/app.html?tab=meetingRooms" },
    { "source": "/meeting-rooms", "destination": "/meeting-rooms.html" },
    { "source": "/meeting-rooms/(.*)", "destination": "/meeting-rooms.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/(.*)", "destination": "/app.html" },
    { "source": "/landing", "destination": "/index.html" },
    { "source": "/public", "destination": "/index.html" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
